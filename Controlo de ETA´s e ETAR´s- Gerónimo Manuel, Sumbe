def main(page: ft.Page):
    page.title = "Controlo Analítico"
    page.window.icon = os.path.join(os.path.dirname(os.path.abspath(__file__)), "assets", "Logo.ico")
    page.window.width = 420
    page.window.height = 800
    page.theme_mode = ft.ThemeMode.SYSTEM
    page.padding = 12

    cronometro = {"rodando": False, "total": 0}

    # ---------------------------- LOGIN ----------------------------
    def mostrar_login():
        page.clean()
        ativo = {"on": True}

        hora = ft.Text("", size=16, weight=ft.FontWeight.BOLD)
        campo_user = ft.TextField(label="Digita o nome de usuário", text_align=ft.TextAlign.CENTER)
        campo_pass = ft.TextField(label="Digita a senha de usuário", password=True,
                                  can_reveal_password=True, text_align=ft.TextAlign.CENTER)
        msg = ft.Text("", color=VERMELHO)

        async def relogio():
            while ativo["on"]:
                hora.value = f"Hora: {time.strftime('%H:%M:%S')}"
                try:
                    hora.update()
                except Exception:
                    break
                await asyncio.sleep(1)

        def entrar(e):
            u = campo_user.value.strip()
            p = campo_pass.value.strip()
            if not u or not p:
                msg.value = "Preencha usuário e senha"
                msg.update()
                return
            users = carregar_users()
            if u in users and users[u]["password"] == _hash(p):
                ativo["on"] = False
                mostrar_app()
            else:
                msg.value = "Credenciais inválidas"
                msg.update()

        def ir_mudar_senha(e):
            ativo["on"] = False
            mostrar_mudar_senha()

        campo_pass.on_submit = entrar

        page.add(
            ft.Column(
                [
                    ft.Text("Tela de login", size=22, weight=ft.FontWeight.BOLD),
                    hora, campo_user, campo_pass, msg,
                    ft.Row([ft.Button("Entrar", on_click=entrar),
                            ft.Button("Mudar senha", on_click=ir_mudar_senha)],
                           alignment=ft.MainAxisAlignment.CENTER),
                ],
                horizontal_alignment=ft.CrossAxisAlignment.STRETCH,
                alignment=ft.MainAxisAlignment.CENTER,
                spacing=12, expand=True,
            )
        )
        page.run_task(relogio)

    def mostrar_mudar_senha():
        page.clean()
        campo_user = ft.TextField(label="Usuário")
        campo_atual = ft.TextField(label="Senha atual", password=True, can_reveal_password=True)
        campo_nova = ft.TextField(label="Nova senha", password=True, can_reveal_password=True)
        campo_conf = ft.TextField(label="Confirmar nova senha", password=True, can_reveal_password=True)
        msg = ft.Text("", color=VERMELHO)

        def mostrar_msg(texto, cor=VERMELHO):
            msg.value = texto
            msg.color = cor
            msg.update()

        async def tentar_mudar(e):
            u = campo_user.value.strip()
            atual = campo_atual.value.strip()
            nova = campo_nova.value.strip()
            conf = campo_conf.value.strip()
            if not u or not atual or not nova:
                return mostrar_msg("Preencha todos os campos")
            if nova != conf:
                return mostrar_msg("Nova senha e confirmação não coincidem")
            users = carregar_users()
            if u not in users:
                return mostrar_msg("Usuário não encontrado")
            if users[u]["password"] != _hash(atual):
                return mostrar_msg("Senha atual incorreta")
            users[u]["password"] = _hash(nova)
            guardar_users(users)
            mostrar_msg("Senha alterada com sucesso", VERDE)
            await asyncio.sleep(1)
            mostrar_login()

        page.add(
            ft.Column(
                [
                    ft.Text("Mudar Senha", size=20, weight=ft.FontWeight.BOLD),
                    campo_user, campo_atual, campo_nova, campo_conf, msg,
                    ft.Row([ft.Button("Confirmar alteração", on_click=tentar_mudar),
                            ft.Button("Fechar", on_click=lambda e: mostrar_login())],
                           alignment=ft.MainAxisAlignment.CENTER),
                ],
                horizontal_alignment=ft.CrossAxisAlignment.STRETCH,
                alignment=ft.MainAxisAlignment.CENTER,
                spacing=12, expand=True,
            )
        )

    # ------------------------- APP PRINCIPAL -------------------------
    def mostrar_app():
        page.clean()

        # ----- cronómetro (sempre visível) -----
        tempo = ft.Text("00:00:00", size=22, weight=ft.FontWeight.BOLD)

        def formatar(total):
            return f"{total // 3600:02d}:{(total % 3600) // 60:02d}:{total % 60:02d}"

        async def loop_cronometro():
            while cronometro["rodando"]:
                await asyncio.sleep(1)
                if not cronometro["rodando"]:
                    break
                cronometro["total"] += 1
                tempo.value = formatar(cronometro["total"])
                try:
                    tempo.update()
                except Exception:
                    cronometro["rodando"] = False
                    break

        def iniciar(e):
            if not cronometro["rodando"]:
                cronometro["rodando"] = True
                cronometro["total"] = 0
                page.run_task(loop_cronometro)

        def parar(e):
            cronometro["rodando"] = False

        def restaurar(e):
            cronometro["total"] = 0
            tempo.value = "00:00:00"
            tempo.update()

        barra_cronometro = ft.Row(
            [
                ft.Text("⏱️ CRONÓMETRO"),
                tempo,
                ft.IconButton(icon=ft.Icons.PLAY_ARROW, icon_color=VERDE, tooltip="Iniciar", on_click=iniciar),
                ft.IconButton(icon=ft.Icons.STOP, icon_color=VERMELHO, tooltip="Parar", on_click=parar),
                ft.IconButton(icon=ft.Icons.REPLAY, tooltip="Restaurar", on_click=restaurar),
            ],
            alignment=ft.MainAxisAlignment.SPACE_BETWEEN,
        )

        # ----- navegação entre secções -----
        corpo = ft.Column(scroll=ft.ScrollMode.AUTO, expand=True,
                          horizontal_alignment=ft.CrossAxisAlignment.STRETCH)
        cache = {}

        def mostrar(i):
            if i not in cache:
                cache[i] = ft.Column(
                    [ft.Text(SECCOES[i][0], size=20, weight=ft.FontWeight.BOLD), SECCOES[i][1]()],
                    spacing=12, horizontal_alignment=ft.CrossAxisAlignment.STRETCH,
                )
            corpo.controls = [cache[i]]
            corpo.update()

        navegacao = ft.Row(
            [ft.TextButton(nome, on_click=lambda e, i=i: mostrar(i)) for i, (nome, _) in enumerate(SECCOES)],
            scroll=ft.ScrollMode.AUTO,
        )

        page.add(
            ft.Column(
                [
                    ft.Text("DilEPASKS", size=20, weight=ft.FontWeight.BOLD),
                    barra_cronometro,
                    navegacao,
                    ft.Divider(),
                    corpo,
                ],
                expand=True,
            )
        )
        mostrar(0)

    mostrar_login()


ft.run(main, assets_dir="assets")
