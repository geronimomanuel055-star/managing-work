def calc_primaria(kg, volume):
    g_l = (kg / volume) * 1000
    if g_l <= 0:
        return f"Valor inválido: {g_l:.4f} g/L", VERMELHO
    if g_l >= 17:
        return f"Cuidado! Excesso pode prejudicar o sistema.\nConcentração: {g_l:.4f} g/L", VERMELHO
    return (f"Concentração calculada: {g_l:.4f} g/L\n"
            f"Verifique se a concentração corresponde ao caudal e à turvação da água bruta."), VERDE


def calc_secundaria(total_kg, vol_total, vazio):
    kg = (vazio / vol_total) * total_kg
    if kg <= 0:
        return f"Valor inválido: {kg:.4f} kg", VERMELHO
    if kg >= 30:
        return f"Cuidado! Excesso pode prejudicar o sistema.\nProduto para a preparação: {kg:.4f} kg", VERMELHO
    return (f"Produto para a preparação: {kg:.4f} kg\n"
            f"Verifique se a concentração corresponde ao caudal e à turvação da água bruta."), VERDE


def calc_debito(caudal, otima_mg_l, producao_g_l):
    debito = (caudal * (otima_mg_l / 1000)) / producao_g_l
    if debito <= 0:
        return f"Valor inválido: {debito:.4f} L/h", VERMELHO
    if debito >= 700:
        return f"Cuidado! Excesso pode prejudicar o sistema.\n Caudal: {debito:.4f} L/h", VERMELHO
    return (f"Débito da bomba doseadora: {debito:.4f} L/h\ne {debito * producao_g_l:.4f} g/h.\n"
            f"Verifique se a concentração corresponde ao caudal e à turvação da água bruta."), VERDE


def calc_turvacao(bruta, destilada, leitura):
    if bruta <= 0 or leitura <= 0 or destilada <= 0:
        return "Valor inválido", VERMELHO
    ntu = ((bruta + destilada) / bruta) * leitura
    if ntu >= 20000:
        return f"Cuidado! dupla ou tripla diluição, pouca exatidão.\nResultado: {ntu:.4f} NTU", VERMELHO
    return (f"Concentração calculada: {ntu:.4f} NTU\n"
            f"Verificar o estado das cuvetes e o interior da célula..."), VERDE


def calc_afericao(tempo):
    if tempo <= 0:
        return f"Valor inválido: {tempo:.4f} s", VERMELHO
    caudal = 3600 / tempo
    if caudal <= 200:
        return f"Cuidado! Pode ser insuficiente pra a ETA convencional.\nCaudal: {caudal:.4f} L/h", VERMELHO
    if caudal >= 600:
        return f"Cuidado! Pode ser excesso de pra a ETA convencional/compacta.\nCaudal: {caudal:.4f} L/h", VERMELHO
    return (f"Caudal: {caudal:.4f} L/h\n"
            f"Verificar a válvula de retenção ou o estado da bomba doseadora"), VERDE


def calc_cuba_cilindrica(altura_cm, raio_cm):
    litros = (raio_cm ** 2 * 3.1416 * altura_cm) / 1000
    if litros <= 0:
        return f"Valor inválido: {litros:.4f} L", VERMELHO
    if litros >= 1000:
        return (f"Cuidado! Tanques novos (cimento de portland) e sem impermeabilizante,\n"
                f"pode consumir o Cloro Residual Livre ou deixar cheiro na água.\n"
                f"Volume: {litros:.4f} L\nVerificar a altura da água dentro do tanque"), VERDE
    return f"Volume: {litros:.4f} L\nVerificar a altura da água dentro do tanque", VERDE


def calc_cuba_retangular(altura, largura, comprimento):
    litros = (altura * largura * comprimento) * 1000
    if litros <= 0:
        return f"Valor inválido: {litros:.4f} L", VERMELHO
    return (f"Cuidado! Tanques novos (cimento de portland) e sem impermeabilizante,\n"
            f"pode consumir o Cloro Residual Livre ou deixar cheiro na água.\n"
            f"Volume: {litros:.4f} L\nVerificar a altura da água dentro do tanque"), VERDE


def calc_molaridade(massa_molecular, massa_pesada, volume_ml):
    mol_l = (massa_pesada / massa_molecular) / (volume_ml / 1000)
    if mol_l <= 0:
        return f"Valor inválido: {mol_l:.4f} Mol/L", VERMELHO
    return (f"Cuidado! Executa com vidraria limpa, seca, fria a temperatura ambiente \n"
            f"e esterelizada com ácido nítrico ou ácido sulfúrico.\n"
            f"Concentração: {mol_l:.4f} Mol/L\nEconomiza reagente!"), VERDE


def calc_erro(referencia, medido):
    absoluto = abs(medido - referencia)
    relativo = (absoluto / referencia) * 100
    return f" Erro absoluto: {absoluto:.4f}. Erro relativo: {relativo:.4f} %", VERDE


def calc_c1v1(c1, v1, v2):
    if c1 <= 0:
        return f"Valor invalido {c1:.4f} mg/L | g/L | %", VERMELHO
    if v1 <= 0:
        return f"Valor invalido {v1:.4f} mL | L", VERMELHO
    if v2 <= 0:
        return f"Valor invalido {v2:.4f} mL | L", VERMELHO
    return f"Concentração: {(c1 * v1) / v2:.4f} mg/L | g/L | %", VERDE


def calc_acrescimo(c1, v1, c2):
    if c1 <= 0:
        return f"Valor invalido {c1:.4f} mg/L | g/L | %", VERMELHO
    if v1 <= 0:
        return f"Valor invalido {v1:.4f} mL | L", VERMELHO
    if c2 <= 0:
        return f"Valor invalido {c2:.4f} mg/L | g/L | %", VERMELHO
    acrescimo = (c1 * v1) / c2 - v1
    return f"Resultado: volume de água destilada à acrescentar: {acrescimo:.4f} mL", VERDE


def calc_acido(densidade, percentagem, volume_ml):
    mg = ((volume_ml * densidade) * (percentagem / 100)) * 1000
    if mg <= 0:
        return f"Valor inválido. {mg:.4f} mg/L | L", VERMELHO
    if volume_ml == 100:
        return f"Volume de 100 mL inserido. Concentração {mg / 100:.4f} mg/ 1 mL", VERDE
    if volume_ml == 10:
        return f"Volume de 10 mL inserido. Concentração {mg / 10:.4f} mg/ 1 mL", VERDE
    return f"Volume inserido diferente de 100 ou 10 mL: {mg:.4f} mg/volume que se adicionou", VERMELHO


def calc_padronizacao(v_primaria, v_secundaria, c_secundaria):
    if v_primaria == 0 or v_secundaria == 0 or c_secundaria == 0:
        return "Valor inválido (não pode ser zero)", VERMELHO
    r = (c_secundaria * v_secundaria) / v_primaria
    return f"Resultado: {r:.6f} mg | g | Mol | N", VERDE


def calc_normalidade(molaridade, n):
    if molaridade <= 0 or n <= 0:
        return f"Valor invalido {molaridade * n:.4f} N ", VERMELHO
    return f"Resultado: {molaridade * n:.4f} N", VERDE


def calc_sst(papel1, papel2, volume_ml):
    # Fórmula mantida exactamente como na versão original
    fator1 = volume_ml / 1000
    fator = (papel2 - papel1) * 1000
    sst = (fator / fator1) * 1000
    ssv = sst * 0.7
    if volume_ml <= 4:
        return "Valor do volume, abaixo de 5 mL.", VERMELHO
    if volume_ml >= 11:
        return "Valor do volume, acima de 10 mL.", VERMELHO
    return (f"Valor do volume inserido entre 5 e 10 mL. \nMelhor devido o entupimento do filtro.\n"
            f"SST {sst:.4f} mg/L e SSV {ssv:.4f} mg/L"), VERDE


def _texto_abs(conc):
    if conc >= 50:
        return (f"Verifica o critério de aceitação, muitos parâmetros estão abaixo de 50 mg/L. \n"
                f"Concentração: {conc:.4f} mg/L "), VERMELHO
    return (f" Ao determinar, verifica a higienização das vidrarias, a validade de cada solução/reagente \n"
            f"e a temperatura da vidraria. Concentração: {conc:.4f} mg/L "), VERDE


def calc_abs_pos_pos(absorvancia, m, c):
    return _texto_abs((absorvancia - c) / m)


def calc_abs_pos_neg(absorvancia, m, c):
    return _texto_abs((absorvancia + c) / m)


def calc_abs_neg_pos(absorvancia, m, c):
    return _texto_abs((absorvancia - c) / (m * -1))


def calc_taxa_superficial(comprimento, largura, caudal):
    taxa = caudal / (comprimento * largura)
    if taxa <= 0:
        return f"Valor inválido {taxa} m3/m2", VERMELHO
    if taxa > 9:
        return f"Cuidado!Taxa de Escoamento Superficial: {taxa:.4f} m3/m2 \nPara ETA´s convencionais 9 m3/m2.", VERMELHO
    if taxa > 4:
        return f"Cuidado!Taxa de Escoamento Superficial: {taxa:.4f} m3/m2 \nPara ETA´s convencionais 4 m3/m2.", VERMELHO
    return f" Taxa de Escoamento Superficial: {taxa:.4f} m3/m2.", VERDE


def calc_taxa_retencao(caudal, volume_orgao):
    retencao = (volume_orgao / caudal) * 60
    renovacao = caudal / volume_orgao
    if retencao <= 0:
        return f"Valor inválido {retencao} h", VERMELHO
    if retencao <= 20:
        return f"Cuidado! Taxa de retenção: {retencao:.4f} fora da referência mínima de 20 min", VERMELHO
    if retencao >= 30:
        return f"Cuidado! Taxa de retenção: {retencao:.4f} fora da referência máxima de 30 min", VERMELHO
    return (f" Taxa de retenção: {retencao:.4f} min. Taxa de renovação: {renovacao:.4f}h. "
            f"\nCuidado para que a renovação da água não esteja inferior a 1h ou acima de 4h "), VERDE


def calc_tensao(agua_destilada, agua_bruta):
    t = (agua_destilada / agua_bruta) * 72
    if t <= 0:
        return f"Valor inválido {t} mN/m", VERMELHO
    if t > 72:
        return (f"Cuidado! Tensão Superficial: {t:.4f} referência = 72 mN/m. "
                f"\nMede a temperatura no intervalo 20º a 25º"), VERMELHO
    return f" Tensão superficial: {t:.4f} mN/m.", VERDE


def calc_gradiente(potencia, viscosidade, volume, fator):
    interior = (potencia * fator) / (viscosidade * volume)
    if interior <= 0:
        return f"Valor inválido. {interior:.4f} s-1", VERMELHO
    g = sqrt(interior)
    if g >= 60:
        return f"Cuidado! Desfragmentação dos flocos. Gradiente: {g:.4f} s-1  \nacima da referência máxima 60 s-1", VERMELHO
    if g <= 20:
        return f"Cuidado! Flocos fracos. Gradiente: {g:.4f} s-1 \nabaixo da referencia mínima 20 s-1", VERMELHO
    return f" Gradiente: {g:.4f} s-1 ", VERDE


def calc_carga_organica(caudal, dbo5_mg_l):
    carga = caudal * (dbo5_mg_l / 1000)
    pct = (carga / 45) * 100
    if carga <= 0:
        return f"Valor inválido. {carga:.4f} kgDBO/dia.", VERMELHO
    if carga > 980:
        return (f"Cuidado! Muito alimento caso for projectada para 985 kgDBO/dia. \n"
                f"Alimento: {carga:.4f} kgDBO/dia. Percentagem {pct:.4f} %"), VERMELHO
    return f" Alimento: {carga:.4f} kgDBO/dia. Percentagem: {pct:.4f} % ", VERDE


def calc_razao_fm(volume_reator, mlssv_mg_l, dbo_kg_dia):
    fm = dbo_kg_dia / (volume_reator * (mlssv_mg_l / 1000))
    if fm <= 0:
        return f"Valor inválido. Concentração: {fm:.4f} kgDBO/kgSSV.d.", VERMELHO
    if fm < 0.1:
        return (f"Cuidado! Lodo velho, marron,\nnitrifica demais e forma espuma. "
                f"Concentração: {fm:.4f} kgDBO/kgSSV.d."), VERMELHO
    if fm > 0.6:
        return (f"Cuidado! Lodo muito jovem,\nfilamentoso, não decanta. "
                f"Concentração: {fm:.4f} kgDBO/kgSSV.d."), VERMELHO
    return f" Floco marron claro, \nsaudável. Concentração: {fm:.4f} kgDBO/kgSSV.d. ", VERDE


def calc_extracao(volume_reator, mlssv, sst_eel, idade_lodo):
    qw = (volume_reator * (mlssv / 1000)) / (idade_lodo * (sst_eel / 1000))
    r1 = mlssv / 1000
    r2 = sst_eel / 1000
    r4 = r1 / (r2 - r1)
    if qw <= 0:
        return (f"Valor inválido. Volume à extrair: {qw:.4f} m3/dia. "
                f"Taxa de recirculação:{r4:.4f} - {r4 * 100:.4f} % do Q afluente."), VERMELHO
    return (f" Volume à extrair: {qw:.4f} m3/dia. "
            f"Taxa de recirculação: {r4:.4f} - {r4 * 100:.4f} % do Q afluente."), VERDE


def calc_idade_lodo(caudal_purga, mlssv, ssv_eel, volume_reator):
    trc = ((mlssv / 1000) * volume_reator) / ((ssv_eel / 1000) * caudal_purga)
    if trc <= 0:
        return f"Valor inválido. Concentração: {trc:.4f} dias.", VERMELHO
    if trc < 5:
        return f"Cuidado! idade do lodo: {trc:.4f} dias. Dias mínimo 5.", VERMELHO
    if trc > 10:
        return f"Cuidado! Idade do lodo: {trc:.4f} dias. Dias máximo 10.", VERMELHO
    return f" Idade do lodo: {trc:.4f} dias", VERDE


def calc_ivl(v30, sst):
    ivl = (v30 / sst) * 1000
    if ivl <= 0:
        return f"Valor inválido. IVL: {ivl:.4f} ml/g.", VERMELHO
    if ivl < 70:
        return f"Cuidado! Decantação deficitária. \nIVL: {ivl:.4f} mL/g. Mínimo 70 mL/g.", VERMELHO
    if ivl > 150:
        return f"Cuidado! Bulking, decantação deficitária. \nIVL: {ivl:.4f} mL/g. Máximo 150 mL/g.", VERMELHO
    return f" IVL: {ivl:.4f} mL/g", VERDE


def calc_mlssv_ssv(sst_reator, sst_eel):
    return (f"MLSSV - MBBR {sst_reator * 0.7:.4f} mg/L. \n"
            f"SSV - EEL: {sst_eel * 0.7:.4f} mg/L."), VERDE


