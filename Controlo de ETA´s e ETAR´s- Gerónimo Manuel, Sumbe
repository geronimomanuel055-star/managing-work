def _hash(texto: str) -> str:
    return hashlib.sha256(texto.encode()).hexdigest()


def _ficheiro_users() -> str:
    # No APK o Flet fornece FLET_APP_STORAGE_DATA (pasta persistente da app).
    # No Windows usa AppData\Local\DilEPASKS, como na versão original.
    pasta = os.getenv("FLET_APP_STORAGE_DATA")
    if not pasta:
        base = os.getenv("LOCALAPPDATA") or os.path.expanduser("~")
        pasta = os.path.join(base, "DilEPASKS")
    os.makedirs(pasta, exist_ok=True)
    caminho = os.path.join(pasta, "users.json")
    if not os.path.exists(caminho):
        with open(caminho, "w", encoding="utf-8") as f:
            json.dump({"admin": {"password": _hash("1234")}}, f, indent=4)
    return caminho


def carregar_users() -> dict:
    with open(_ficheiro_users(), "r", encoding="utf-8") as f:
        return json.load(f)


def guardar_users(users: dict) -> None:
    with open(_ficheiro_users(), "w", encoding="utf-8") as f:
        json.dump(users, f, indent=4)


