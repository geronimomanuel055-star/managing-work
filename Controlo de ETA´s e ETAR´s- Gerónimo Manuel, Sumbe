def num(campo: ft.TextField) -> float:
    """Lê o campo como número (aceita vírgula ou ponto)."""
    return float(campo.value.replace(",", ".").strip())


def titulo(texto: str) -> ft.Text:
    return ft.Text(texto, size=16, weight=ft.FontWeight.BOLD)


def bloco(titulo_texto, campos, botao, calcular, extra=None):
    """
    Cria um bloco: título + campos numéricos + botão + resultado.
    campos  -> lista com os rótulos dos campos
    calcular -> função(valores...) que devolve (texto, cor)
    """
    entradas = [
        ft.TextField(label=rotulo, keyboard_type=ft.KeyboardType.NUMBER)
        for rotulo in campos
    ]
    resultado = ft.Text("Resultado aparecerá aqui")

    def ao_clicar(e):
        try:
            valores = [num(c) for c in entradas]
            texto, cor = calcular(*valores)
        except ValueError:
            texto, cor = "Por favor insere apenas números válidos.", VERMELHO
        except ZeroDivisionError:
            texto, cor = "Valor inválido: divisão por zero.", VERMELHO
        except Exception as ex:
            texto, cor = f"Ocorreu um problema: {ex}", VERMELHO
        resultado.value = texto
        resultado.color = cor
        resultado.update()

    return ft.Column(
        [titulo(titulo_texto), *(extra or []), *entradas, ft.Button(botao, on_click=ao_clicar), resultado],
        spacing=8,
        horizontal_alignment=ft.CrossAxisAlignment.STRETCH,
    )


def juntar(*blocos):
    itens = []
    for b in blocos:
        itens += [b, ft.Divider()]
    return ft.Column(itens[:-1], spacing=12, horizontal_alignment=ft.CrossAxisAlignment.STRETCH)


def conversor(titulo_texto, fatores, de, para):
    valor = ft.TextField(label="Digita o valor", keyboard_type=ft.KeyboardType.NUMBER)
    origem = ft.Dropdown(label="De", value=de, expand=True,
                         options=[ft.DropdownOption(key=k) for k in fatores])
    destino = ft.Dropdown(label="Para", value=para, expand=True,
                          options=[ft.DropdownOption(key=k) for k in fatores])
    resultado = ft.Text("Resultado aparecerá aqui")

    def converter(e):
        try:
            v = num(valor)
            base = v * fatores[origem.value]
            r = base / fatores[destino.value]
            resultado.value = f"{v} {origem.value} = {r:.4f} {destino.value}"
        except ValueError:
            resultado.value = "Digite um número válido."
        resultado.update()

    return ft.Column(
        [titulo(titulo_texto), valor, ft.Row([origem, destino]),
         ft.Button("Converter🔄", on_click=converter), resultado],
        spacing=8, horizontal_alignment=ft.CrossAxisAlignment.STRETCH,
    )


